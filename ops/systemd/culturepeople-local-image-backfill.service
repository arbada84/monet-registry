[Unit]
Description=CulturePeople local image backfill
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
Environment=CULTUREPEOPLE_DISK_UUID=96B82074B8205551
ExecStart=/usr/bin/bash -lc 'set -euo pipefail; DEVICE="$(lsblk -nrpo NAME,UUID | while read -r DEV ID; do if [ "$ID" = "$CULTUREPEOPLE_DISK_UUID" ]; then printf "%s\n" "$DEV"; break; fi; done)"; test -n "$DEVICE"; MOUNT_ROOT="$(findmnt -rn -S "$DEVICE" -o TARGET | head -n 1)"; test -n "$MOUNT_ROOT"; CULTUREPEOPLE_REPO="$MOUNT_ROOT/Users/Documents/monet-registry-main"; CULTUREPEOPLE_BACKUP_ROOT="$CULTUREPEOPLE_REPO/culturepeople-backups"; cd "$CULTUREPEOPLE_REPO" && python3 scripts/local_media_backfill.py --root "$CULTUREPEOPLE_BACKUP_ROOT" --max-new-media 50 --delay-ms 2000 --timeout-ms 30000 --min-free-gb 10'
