[Unit]
Description=CulturePeople weekly primary and second-copy restore rehearsal
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
Environment=CULTUREPEOPLE_DISK_UUID=96B82074B8205551
EnvironmentFile=-%h/.config/culturepeople/backup-health.env
ExecStart=/usr/bin/bash -lc 'set -euo pipefail; DEVICE="$(lsblk -nrpo NAME,UUID | while read -r DEV ID; do if [ "$ID" = "$CULTUREPEOPLE_DISK_UUID" ]; then printf "%s\n" "$DEV"; break; fi; done)"; test -n "$DEVICE"; MOUNT_ROOT="$(findmnt -rn -S "$DEVICE" -o TARGET | head -n 1)"; test -n "$MOUNT_ROOT"; REPO="$MOUNT_ROOT/Users/Documents/monet-registry-main"; ROOT="$REPO/culturepeople-backups"; cd "$REPO"; EXTRA=(); if [ "${CULTUREPEOPLE_BACKUP_ALERT_APPLY:-0}" = "1" ]; then EXTRA+=(--apply --confirm SEND_BACKUP_HEALTH_ALERT); fi; pnpm backup:health:notify -- --root "$ROOT" --run-restore-check-all --strict "${EXTRA[@]}"'
