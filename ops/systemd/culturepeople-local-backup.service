[Unit]
Description=CulturePeople local unified backup
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
Environment=CULTUREPEOPLE_REPO=%h/dev/monet-registry-main
Environment=CULTUREPEOPLE_BACKUP_ROOT=%h/culturepeople-backups
ExecStart=/usr/bin/bash -lc 'cd "$CULTUREPEOPLE_REPO" && pnpm backup:local -- --out "$CULTUREPEOPLE_BACKUP_ROOT" --media-concurrency 1 --media-delay-ms 1500 --media-timeout-ms 90000 --media-retries 1 --media-retry-delay-ms 5000 --max-new-media 300 --min-free-gb 10 --retention-days 90 && pnpm backup:local:sqlite -- --root "$CULTUREPEOPLE_BACKUP_ROOT" && pnpm backup:local:verify -- --root "$CULTUREPEOPLE_BACKUP_ROOT" --require-sqlite && pnpm backup:local:status -- --root "$CULTUREPEOPLE_BACKUP_ROOT"'
